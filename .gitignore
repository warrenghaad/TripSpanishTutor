node_modules
dist
.DS_Store

# Capacitor — native iOS shell. Generated by `npx cap add ios` on a Mac;
# rebuilt by `npm run cap:sync`. See docs/ios-sideload.md.
ios/App/App/public/
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/.xcode.env.local

# Generated vault snapshot — produced by `npm run snapshot:vault`.
client/public/vault-snapshot.json
server/public
vite.config.ts.*
*.tar.gz

# Obsidian per-machine config — lives inside the vault root on each laptop.
# We track the vault content (the twelve numbered folders) but NOT each
# machine's themes, hotkeys, plugins, workspace layout. See
# docs/obsidian-sync.md.
.obsidian/
VallartaVoxVault/.obsidian/
**/.obsidian/

# Obsidian Git plugin's own working files.
.obsidian-git-data/

# Obsidian trash (when "Move to .trash folder" deletion mode is used).
.trash/
VallartaVoxVault/.trash/
