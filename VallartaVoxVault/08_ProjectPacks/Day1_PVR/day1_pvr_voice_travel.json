    {
      "id": "travel.gate.where",
      "type": "phrase",
      "title": "Where is the gate?",
      "spanish": "¿Dónde está la puerta?",
      "english": "Where is the gate?",
      "literal": "Where is the door/gate?",
      "grammar": [
        "dónde = where",
        "está = is, from estar (location)",
        "la puerta = feminine noun"
      ],
      "when_to_use": "Finding any gate, doorway, or specific location at the airport.",
      "practice": [
        "¿Dónde está la salida?",
        "¿Dónde está el baño?",
        "¿Dónde está el taxi?"
      ],
      "tags": ["spanish", "travel", "pvr", "airport", "estar"],
      "source_notes": ["08_ProjectPacks/Day1_PVR/01 Airport Survival.md"]
    },
    {
      "id": "travel.bathroom.where",
      "type": "phrase",
      "title": "Where is the bathroom?",
      "spanish": "¿Dónde está el baño?",
      "english": "Where is the bathroom?",
      "literal": "Where is the bathroom?",
      "grammar": ["¿Dónde está + el baño?"],
      "when_to_use": "Any time, anywhere.",
      "practice": ["¿Hay un baño cerca?", "¿El baño está por aquí?"],
      "tags": ["spanish", "travel", "pvr", "bathroom"],
